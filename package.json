{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "growcam-pc",
    "version": "1.3.0",
    "private": true,
    "description": "Local dashboard, daily rewind, and time-lapse tools for the VIVOSUN GrowCam C4",
    "keywords": [
        "camera",
        "camera-viewer",
        "dvrip",
        "growcam",
        "growcam-c4",
        "hevc",
        "ip-camera",
        "rtsp",
        "time-lapse",
        "vivosun",
        "vivosun-growcam",
        "xmeye"
    ],
    "homepage": "https://nick2bad4u.github.io/growcam-pc/",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/growcam-pc/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/growcam-pc.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "scripts": {
        "build": "npm run docs:build",
        "build:python": "uv build --clear",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/growcam-pc --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/growcam-pc --unreleased",
        "changelog:preview:offline": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/growcam-pc --unreleased --offline",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/growcam-pc --current",
        "changelog:release-notes:file": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/growcam-pc --current --output .cache/release-notes.md",
        "check:package": "uv run twine check dist/*",
        "check:python": "npm run lint:python && npm run typecheck:python && npm run test:python && npm run compile:python",
        "compile:python": "uv run python -m compileall -q src tests",
        "docs:build": "docusaurus build website",
        "docs:clear": "docusaurus clear website",
        "docs:serve": "docusaurus serve website",
        "docs:start": "docusaurus start website",
        "format": "npm run format:python && npm run lint:remark:fix",
        "format:check": "uv run ruff format --check .",
        "format:python": "uv run ruff check --fix . && uv run ruff format .",
        "lint": "npm run lint:python && npm run lint:js && npm run lint:stylelint && npm run lint:package-json && npm run lint:remark && npm run lint:secretlint",
        "lint:eslint": "eslint \"**/*.{js,jsx,mjs,cjs}\" --report-unused-disable-directives --max-warnings=0",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:html": "htmlhint --config node_modules/htmlhint-config-nick2bad4u/recommended.json \"**/*.html\"",
        "lint:js": "npm run lint:js:syntax && npm run lint:eslint",
        "lint:js:syntax": "node --check src/growcam/static/app.js",
        "lint:jscpd": "jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --exclude \"^.*pypi[.]org/project/growcam-pc/?$\" --exclude \"^https://nick2bad4u[.]github[.]io/?$\" --exclude \"^https://nick2bad4u[.]github[.]io/growcam-pc/docs/growcam-c4-setup/?$\" --exclude \"^.*github[.]com/Nick2bad4u/growcam-pc/compare/v1[.]2[.]1[.][.][.]v1[.]3[.]0$\" --exclude \"^.*github[.]com/Nick2bad4u/growcam-pc/compare/v1[.]3[.]0[.][.][.]HEAD$\" README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md website",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md website",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:python": "uv run ruff check . && uv run ruff format --check .",
        "lint:remark": "remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "remark . --ignore-path .remarkignore --output",
        "lint:secretlint": "secretlint --secretlintrc .secretlintrc.cjs --secretlintignore .gitignore \"**/*\"",
        "lint:stylelint": "stylelint \"src/**/*.css\" \"website/**/*.css\" --max-warnings=0",
        "lint:templates": "djlint --configuration node_modules/djlint-config-nick2bad4u/recommended.json --lint .",
        "python:bootstrap": "uv sync --frozen --all-groups",
        "python:venv": "npm run python:bootstrap",
        "release:verify": "npm run check:python && npm run lint:js && npm run lint:stylelint && npm run lint:package-json && npm run lint:remark && npm run lint:secretlint && npm run build:python && npm run check:package && npm run docs:build && npm run changelog:preview:offline",
        "test": "uv run pytest",
        "test:coverage": "npm run test:python",
        "test:python": "uv run pytest --cov --cov-report=term-missing --cov-report=xml --junitxml=coverage/pytest/junit.xml",
        "typecheck": "npm run typecheck:python",
        "typecheck:mypy": "uv run mypy",
        "typecheck:pyright": "uv run pyright",
        "typecheck:python": "npm run typecheck:mypy && npm run typecheck:pyright",
        "update-actions": "npx actions-up --yes --style sha --quiet",
        "update-all": "npm run update-actions && npm run update-deps",
        "update-deps": "ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm update --force && npm install --force"
    },
    "overrides": {
        "serialize-javascript": "7.0.7",
        "uuid": "11.1.1"
    },
    "devDependencies": {
        "@docusaurus/core": "^3.10.2",
        "@docusaurus/preset-classic": "^3.10.2",
        "djlint-config-nick2bad4u": "^1.0.0",
        "eslint": "^10.8.1",
        "eslint-config-nick2bad4u": "^14.1.0",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.5.0",
        "gitleaks-config-nick2bad4u": "^1.0.4",
        "htmlhint": "^1.9.2",
        "htmlhint-config-nick2bad4u": "^1.0.0",
        "jscpd": "^5.0.16",
        "jscpd-config-nick2bad4u": "^1.1.0",
        "lychee-config-nick2bad4u": "^3.0.0",
        "ncu-config-nick2bad4u": "^0.2.1",
        "npm-check-updates": "^23.0.2",
        "npm-package-json-lint": "^11.0.0",
        "prettier": "^3.9.6",
        "prettier-config-nick2bad4u": "^2.0.2",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.4",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "stylelint": "^17.14.1",
        "stylelint-config-nick2bad4u": "^2.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=12.0.0"
    },
    "allowScripts": {
        "core-js": false,
        "esbuild@0.27.7 || 0.28.1 || 0.28.2": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true
    }
}
